# With these defaults the app runs locally without model weights or API keys.
DOCLENS_PROVIDER=extractive
DOCLENS_EMBEDDINGS=lsa

# Generation: select "ollama" or "openai" above, then configure as needed.
# DOCLENS_MODEL=qwen2.5:3b
# DOCLENS_LLM_BASE_URL=http://127.0.0.1:11434
# DOCLENS_LLM_API_KEY=

# Neural retrieval requires uv sync --extra semantic.
# DOCLENS_EMBEDDINGS=sentence-transformers
# DOCLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DOCLENS_EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
# DOCLENS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# DOCLENS_RERANK_REVISION=
# DOCLENS_LOCAL_MODELS_ONLY=1
